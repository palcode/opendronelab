  "userNodes": {
    "odl-localization-error": {
      "name": "localization_error",
      "sourceCode": "// OpenDroneLab: EKF2 vs ground-truth error, in NED (metres).\n// Ground truth /ground_truth/odometry is ENU (Gazebo world): north = y,\n// east = x, down = -z. EKF2 vehicle_local_position_v1 is NED.\n// Each EKF2 sample is compared with the latest GT sample (zero-order hold,\n// GT at 50 Hz), WITHOUT origin alignment, so values include the constant\n// EKF2-origin vs Gazebo-origin offset. localization_metrics / evo-check.sh\n// remain the reference numbers.\nimport { Input } from \"./types\";\n\nexport const inputs = [\"/ground_truth/odometry\", \"/fmu/out/vehicle_local_position_v1\"];\nexport const output = \"/studio_script/localization_error\";\n\ntype Output = {\n  north_err: number;\n  east_err: number;\n  down_err: number;\n  horiz_err: number;\n  err_3d: number;\n};\n\nlet gt: { n: number; e: number; d: number } | undefined;\n\nexport default function script(\n  event: Input<\"/ground_truth/odometry\"> | Input<\"/fmu/out/vehicle_local_position_v1\">,\n): Output | undefined {\n  const msg = event.message as any;\n  if (event.topic === \"/ground_truth/odometry\") {\n    const p = msg.pose.pose.position;\n    gt = { n: p.y, e: p.x, d: -p.z };\n    return undefined;\n  }\n  if (gt === undefined) {\n    return undefined;\n  }\n  const dn = msg.x - gt.n;\n  const de = msg.y - gt.e;\n  const dd = msg.z - gt.d;\n  return {\n    north_err: dn,\n    east_err: de,\n    down_err: dd,\n    horiz_err: Math.hypot(dn, de),\n    err_3d: Math.hypot(dn, de, dd),\n  };\n}\n"
    }
  },
