<?xml version="1.0" ?>
<!--
  Detection Test World for OpenDroneLab
  VIO bring-up world: textured props along +Y (camera forward at PX4 yaw 0 / North).

  World name MUST be "detection_test" so it matches PX4_GZ_WORLD=detection_test
  (gz topics become /world/detection_test/...).

  Placement: PX4 yaw 0 faces Gazebo +Y (North); mono_cam looks body +X = +Y world.
  Props and a colored box corridor sit at positive Y so OpenVINS has features.
-->
<sdf version="1.9">
  <world name="vio_test">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- No <plugin> list: PX4 server.config supplies the systems (incl. magnetometer), same as default.sdf -->

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Person (COCO 0): static Standing person (not the Walking mesh) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>person_1</name>
      <pose>0 4 0 0 0 1.57</pose>
    </include>

    <!-- Car (COCO 2) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>car_1</name>
      <pose>-2 6 0 0 0 0</pose>
    </include>

    <!-- Chair (COCO 56) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>chair_1</name>
      <pose>1.5 3.5 0 0 0 0.5</pose>
    </include>

    <!-- Bottle stand-in (COCO 39): Beer model is a recognizable bottle shape -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Beer</uri>
      <name>bottle_1</name>
      <pose>-1 3.2 0.15 0 0 0</pose>
    </include>

    <!-- Backpack (COCO 24) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Backpack</uri>
      <name>backpack_1</name>
      <pose>1.2 5 0.3 0 0 0</pose>
    </include>


    <model name="tex_box_L_1">
      <static>true</static>
      <pose>-2.5 2.0 0.6000000000000001 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 1.2000000000000002</size></box></geometry></collision>
