# syntax=docker/dockerfile:1
# OpenDroneLab Development Container
# Ubuntu 24.04 with PX4, Gazebo Harmonic, ROS 2 Jazzy, and Micro XRCE-DDS Agent
# Built for non-root user matching host UID/GID for X11 authorization.
# Tag convention: opendronelab-dev:phase5-clean (exact pip pins + BuildKit caches).

# Pin by digest of the locally present ubuntu:24.04 (tag kept for humans).
# Digest verified 2026-11-05: docker images ubuntu:24.04 --digests
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

# Build arguments for user creation
ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=dev

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Keep apt downloads in the BuildKit cache mount across builds.
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
        > /etc/apt/apt.conf.d/keep-cache

# Install base dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    locales \
    sudo \
    wget \
    && locale-gen en_US.UTF-8

# Add Gazebo package repository for Harmonic
RUN curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
    -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] \
    http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/gazebo-stable.list

# Add ROS 2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/ros2.list

# Install Gazebo Harmonic (pinned version)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gz-harmonic=1.0.0-1~noble \
    libunwind-dev \
    cppzmq-dev \
    dmidecode \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libeigen3-dev \
    libimage-exiftool-perl \
    libopencv-dev \
    protobuf-compiler

# Install ROS 2 Jazzy
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base \
    ros-dev-tools \
    python3-colcon-common-extensions

# Install PX4 dependencies (from ubuntu.sh without NuttX toolchain)
# Based on PX4-Autopilot/Tools/setup/ubuntu.sh
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    astyle \
    build-essential \
    ccache \
    clang \
    clang-tidy \
    cmake \
    cppcheck \
    file \
    g++ \
    gcc \
    gdb \
    git \
    lcov \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer1.0-dev \
    libxml2-dev \
    libxml2-utils \
    make \
    ninja-build \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    rsync \
    shellcheck \
    unzip \
    xsltproc \
    zip

# Pip constraints (numpy<2, onnxruntime-gpu pin). Copied early so later pip
# layers can -c against it without invalidating the heavy apt layers above.
COPY constraints.txt /tmp/constraints.txt

# Install Python packages for PX4 from the v1.17.0 tag's own requirements list
RUN --mount=type=cache,target=/root/.cache/pip \
    curl -fsSL https://raw.githubusercontent.com/PX4/PX4-Autopilot/v1.17.0/Tools/setup/requirements.txt -o /tmp/px4-requirements.txt \
    && pip3 install --break-system-packages --ignore-installed \
        -c /tmp/constraints.txt -r /tmp/px4-requirements.txt \
    && rm /tmp/px4-requirements.txt

# Install additional tools for Gazebo GUI and OpenGL
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-dri \
    libglx-mesa0 \
    mesa-utils \
    x11-apps

# Install Micro XRCE-DDS Agent dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    default-jre \
    libgtest-dev \
    libasio-dev \
    libtinyxml2-dev

# Create non-root user with matching UID/GID
# (ubuntu:24.04 ships a default 'ubuntu' user at UID/GID 1000; remove it first)
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && (groupdel ubuntu 2>/dev/null || true) \
    && groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Switch to non-root user
USER $USERNAME
WORKDIR /home/$USERNAME

# Clone and build Micro XRCE-DDS Agent v2.4.3 as user (ccache speeds rebuilds)
RUN --mount=type=cache,target=/home/dev/.ccache,uid=1000,gid=1000 \
    export CCACHE_DIR=/home/dev/.ccache \
    && export PATH="/usr/lib/ccache:$PATH" \
    && git clone -b v2.4.3 --depth 1 https://github.com/eProsima/Micro-XRCE-DDS-Agent.git \
    && cd Micro-XRCE-DDS-Agent \
    && mkdir build && cd build \
    && cmake -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache .. \
    && make -j$(nproc) \
    && sudo make install \
    && sudo ldconfig \
    && ccache -s || true \
    && cd ../.. \
    && rm -rf Micro-XRCE-DDS-Agent

# Set up environment
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
# Let the NVIDIA runtime inject GL/Vulkan driver libs (needed for Gazebo on the GPU)
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all

# Camera / perception: Gazebo<->ROS 2 bridge and image tooling (Phase 3)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    sudo apt-get update && sudo apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-image \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-transport \
    ros-jazzy-rqt-image-view \
    ros-jazzy-vision-msgs \
    python3-opencv \
    python3-matplotlib

# Enforce numpy 1.x (apt python3-opencv) via constraints, then install
# onnxruntime-gpu[cuda,cudnn]. CUDA/cuDNN come from the nvidia-* pip wheels
# (no CUDA toolkit in the image). Host driver 595 reports CUDA 13.2, matching
# the CUDA 13 default of onnxruntime-gpu >= 1.27. Do NOT also install
# onnxruntime (CPU-only); the two packages conflict.
RUN --mount=type=cache,target=/root/.cache/pip \
    sudo pip3 install --break-system-packages --ignore-installed \
        -c /tmp/constraints.txt "numpy==1.26.4" \
    && sudo pip3 install --break-system-packages \
        -c /tmp/constraints.txt "onnxruntime-gpu[cuda,cudnn]==1.28.0" \
    && sudo pip3 install --break-system-packages --ignore-installed \
        -c /tmp/constraints.txt "numpy==1.26.4"

# OpenVINS build deps (GPL-3 stack is built later into /data, not linked into
# first-party packages). Ceres is required by ov_init / ov_msckf.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    sudo apt-get update && sudo apt-get install -y --no-install-recommends \
    libceres-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-date-time-dev \
    libboost-thread-dev

# Phase 4b analysis tools.
# evo (GPL-3) lives in its own venv and is used ONLY as an external CLI
# (scripts/evo-check.sh). Our packages must never `import evo`; the system
# python cannot see it. Version pinned in constraints.txt (numpy<2 kept too).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    sudo apt-get update && sudo apt-get install -y --no-install-recommends \
    python3-venv
RUN --mount=type=cache,target=/root/.cache/pip \
    sudo python3 -m venv /opt/evo \
    && sudo /opt/evo/bin/pip install -c /tmp/constraints.txt "evo==1.38.1" \
    && sudo sh -c '/opt/evo/bin/pip freeze > /opt/evo/freeze.txt' \
    && for b in /opt/evo/bin/evo_*; do sudo ln -s "$b" /usr/local/bin/; done

# mcap CLI (MIT), pinned release binary verified by sha256
# (digest from the GitHub release asset, re-checked by download 2026-11-06).
ARG MCAP_VERSION=0.4.0
ARG MCAP_SHA256=3ace13bc8f0273c69742f25695f7f2df84aed57ddd7c36d5f9a59561dc719fb1
RUN curl -fsSL -o /tmp/mcap \
        "https://github.com/foxglove/mcap/releases/download/releases%2Fmcap-cli%2Fv${MCAP_VERSION}/mcap-linux-amd64" \
    && echo "${MCAP_SHA256}  /tmp/mcap" | sha256sum -c - \
    && sudo install -m 0755 /tmp/mcap /usr/local/bin/mcap \
    && rm -f /tmp/mcap

# Source ROS 2 setup in bashrc
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc

# Create workspace directories
RUN mkdir -p /home/$USERNAME/workspace /home/$USERNAME/data

# Build smoke test (exact pins). px4_msgs is not in the image (/data overlay).
COPY smoke-check.sh /tmp/smoke-check.sh
USER root
RUN chmod +x /tmp/smoke-check.sh && /tmp/smoke-check.sh && rm -f /tmp/smoke-check.sh
USER $USERNAME

# Default command
CMD ["/bin/bash"]

# Labels
LABEL org.opencontainers.image.title="OpenDroneLab Dev Container"
LABEL org.opencontainers.image.description="PX4 SITL development with Gazebo Harmonic and ROS 2 Jazzy"
LABEL org.opencontainers.image.version="0.5.0-clean"
